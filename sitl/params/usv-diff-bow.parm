MOT_THR_MIN      -100
MOT_THR_MAX      100
CRUISE_SPEED     1.0
CRUISE_THROTTLE  30
WP_RADIUS        3
WP_SPEED         1.0
TURN_RADIUS      1.0
FS_GCS_ENABLE    1
FS_ACTION        1
ARMING_CHECK     1
SCHED_LOOP_RATE  50
