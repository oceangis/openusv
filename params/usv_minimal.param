# ============================================================================
# USV 精简参数配置 - 优化 4G/低带宽链路
# ArduPilot Rover ESP32-S3
# ============================================================================

# ----------------------------------------------------------------------------
# MAVLink 流速率 - 串口0 (4G 遥测)
# 目标带宽: 2-3 KB/s
# ----------------------------------------------------------------------------
SR0_RAW_SENS,0          # 禁用原始传感器数据 (IMU/Baro原始值)
SR0_EXT_STAT,1          # GPS状态 1Hz
SR0_RC_CHAN,1           # RC通道 1Hz
SR0_RAW_CTRL,0          # 禁用原始控制输出
SR0_POSITION,2          # 位置 2Hz (核心数据)
SR0_EXTRA1,1            # 姿态 1Hz (最低非零值)            # 姿态 2Hz (核心数据)
SR0_EXTRA2,1            # VFR_HUD 1Hz (速度/航向)
SR0_EXTRA3,0            # 禁用 AHRS2/WIND 等
SR0_PARAMS,10           # 参数流 10Hz (仅连接时)
SR0_ADSB,0              # 禁用 ADSB (航空专用)

# ----------------------------------------------------------------------------
# MAVLink 流速率 - 串口1 (本地调试/备用)
# ----------------------------------------------------------------------------
SR1_RAW_SENS,0
SR1_EXT_STAT,1
SR1_RC_CHAN,1
SR1_RAW_CTRL,0
SR1_POSITION,2
SR1_EXTRA1,1
SR1_EXTRA2,1
SR1_EXTRA3,0
SR1_PARAMS,10
SR1_ADSB,0

# ----------------------------------------------------------------------------
# 禁用 USV 不需要的功能
# ----------------------------------------------------------------------------
FENCE_ENABLE,1          # 保留地理围栏 (安全)
FENCE_ACTION,1          # 围栏触发: RTL

# 禁用航空功能
ADSB_TYPE,0             # 禁用 ADSB
TERRAIN_ENABLE,0        # 禁用地形跟随

# 禁用不需要的传感器日志
LOG_BITMASK,176126      # 精简日志 (保留GPS/ATT/RCIN/RCOUT/CMD/MSG)

# ----------------------------------------------------------------------------
# 通信优化
# ----------------------------------------------------------------------------
SERIAL0_BAUD,57         # 4G链路 57600 (节省带宽)
SERIAL0_PROTOCOL,2      # MAVLink2

# ----------------------------------------------------------------------------
# USV 核心参数
# ----------------------------------------------------------------------------
# 船体类型
FRAME_CLASS,2           # Boat

# 导航
WP_RADIUS,3             # 航点半径 3m (船惯性大)
WP_SPEED,2              # 巡航速度 2m/s
TURN_RADIUS,2           # 转弯半径 2m

# 航向源 (使用GPS双天线航向)
AHRS_EKF_TYPE,3         # EKF3
EK3_SRC1_YAW,2          # GPS航向作为偏航源

# ----------------------------------------------------------------------------
# 电池监控 (保留,关键数据)
# ----------------------------------------------------------------------------
BATT_MONITOR,4          # 模拟电压+电流
BATT_LOW_VOLT,11.1      # 低电压警告 (3S)
BATT_CRT_VOLT,10.5      # 临界电压

# ----------------------------------------------------------------------------
# 故障保护
# ----------------------------------------------------------------------------
FS_ACTION,1             # 失联: RTL
FS_TIMEOUT,5            # 5秒超时
FS_GCS_ENABLE,1         # 启用GCS失联保护
